FPL_BASE_URL=https://fantasy.premierleague.com/api/
OPENAI_API_KEY=sk-your-openai-key-here
DEBUG=True
CORS_ORIGINS=http://localhost:5173

# Optional LLM tuning
# OPENAI_MODEL=gpt-5-mini
# Reasoning models spend this budget on hidden reasoning tokens before any
# visible text, so setting it too low yields empty chat replies.
# OPENAI_MAX_COMPLETION_TOKENS=4000

# Optional (not currently used - reserved for future JWT/session authentication)
# SECRET_KEY=your-secret-key-for-jwt-here
